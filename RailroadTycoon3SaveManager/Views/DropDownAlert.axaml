<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:RailroadTycoon3SaveManager.Views"
             mc:Ignorable="d" d:DesignWidth="421" d:DesignHeight="128"
             MinWidth="300" MinHeight="128"
             x:Class="RailroadTycoon3SaveManager.Views.DropDownAlert"
             x:DataType="views:DropDownAlert"
             x:Name="ParentRoot">

    <UserControl.Styles>
        <!-- Slide animation transition for MainGrid -->
        <Style Selector="Grid#MainGrid">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Grid x:Name="MainGrid" VerticalAlignment="Top" Margin="10,0">
        <Border Background="#2D2D2D" 
                BorderBrush="#444444" 
                BorderThickness="1" 
                CornerRadius="0,0,8,8"
                BoxShadow="0 4 15 0 #80000000">
            <Grid RowDefinitions="*, Auto">
                
                <!-- CONTENT ROW -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
                    <!-- Alert Icon -->
                    <Viewbox Width="48" Height="48" Margin="20,10,16,10">
                        <Canvas Width="100" Height="100">
                            <!-- Base Circle -->
                            <Ellipse Width="60" Height="60" Canvas.Left="20" Canvas.Top="20" 
                                     Fill="#40FFFFFF" Stroke="Black" StrokeThickness="4"/>
                            <!-- Exclamation Mark -->
                            <Rectangle Width="6" Height="22" Canvas.Left="47" Canvas.Top="34" 
                                       Fill="Black" RadiusX="3" RadiusY="3"/>
                            <Ellipse Width="7" Height="7" Canvas.Left="46.5" Canvas.Top="60.5" 
                                     Fill="Black"/>
                        </Canvas>
                    </Viewbox>

                    <TextBlock Grid.Column="1"
                               Text="{Binding AlertMessage, ElementName=ParentRoot}"
                               VerticalAlignment="Center" 
                               Margin="2,0,12,0" 
                               TextWrapping="Wrap" 
                               FontSize="12" 
                               Foreground="#DDDDDD"/>
                </Grid>

                <!-- BUTTONS ROW -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,12,12" Spacing="8">
                    <Button x:Name="CancelButton" 
                            Click="CancelButton_Click" 
                            Content="Cancel" 
                            IsCancel="True"/>
                    <Button x:Name="ConfirmButton" 
                            Click="ConfirmButton_Click" 
                            Content="Confirm" 
                            Classes="accent"
                            IsDefault="True"/>
                </StackPanel>
                
            </Grid>
        </Border>
    </Grid>
</UserControl>