<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RailroadTycoon3SaveManager.ViewModels"
        xmlns:views="clr-namespace:RailroadTycoon3SaveManager.Views"
        mc:Ignorable="d" d:DesignWidth="380"
        x:Class="RailroadTycoon3SaveManager.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/rrt3sm.ico"
        Title="Railroad Tycoon 3 Save Manager"
        Width="380"
        MinWidth="380" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *">
        
        <!-- HEADER / DIRECTORY BAR -->
        <Border Grid.Row="0" Padding="16">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Save Directory" FontSize="11"  Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SaveDirectory, Converter={StaticResource PathDisplayFormatter}}"
                               FontSize="14" 
                               FontWeight="Bold" 
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                
                <Button Grid.Column="1" 
                        Content="Browse..." 
                        Command="{Binding BrowseCommand}" 
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- SAVE GAMES LIST -->
        <ScrollViewer Grid.Row="1" Padding="16">
            <ListBox ItemsSource="{Binding SaveGames}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SaveGameViewModel">
                        <views:SaveGameControl />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                
                <!-- Disable default selection highlighting for a clean list feel -->
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </ListBox.Styles>
            </ListBox>
        </ScrollViewer>
        
    </Grid>
</Window>